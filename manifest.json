{
  "manifest_version": 2,
  "name": "GitHub PR Feed Replacer",
  "version": "1.0",
  "description": "Replaces GitHub's news feed with your pull requests table",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "https://github.com/"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "github-pr-feed-replacer@yourdomain.com"
    }
  }
}
